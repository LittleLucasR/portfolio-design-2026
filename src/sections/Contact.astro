<section id="contact" class="relative flex min-h-screen w-full items-center px-6 py-20 sm:px-10 lg:px-16">
  <div class="mx-auto w-full max-w-[1280px]">

    <!-- Header -->
    <header class="mb-16 border-b border-white/10 pb-8">
      <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-works-accent">
        Contato
      </span>
      <h2 class="mt-2 text-3xl font-semibold leading-[1.05] tracking-tight text-works-text sm:text-4xl lg:text-5xl">
        Vamos trabalhar
        <span class="text-works-muted">juntos!</span>
      </h2>
    </header>

    <div class="grid grid-cols-1 gap-px  lg:grid-cols-2">

      <!-- WhatsApp -->
      <a
        href="https://wa.me/5553999054274"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between gap-12 bg-transparent p-8 transition-colors duration-200
               hover:bg-white/5 lg:p-12"
      >
        <div class="flex items-start justify-between">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-works-accent">
            WhatsApp
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            class="text-works-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-works-text"
            aria-hidden="true"
          >
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
        </div>

        <span class="text-2xl font-semibold tracking-tight text-works-text transition-colors duration-200
                     group-hover:text-white sm:text-3xl lg:text-4xl">
          +55 (53) 99905‑4274
        </span>
      </a>

      <!-- Email -->
      <a
        href="mailto:lucas.oronha18@gmail.com"
        class="group flex flex-col justify-between gap-12 bg-transparent p-8 transition-colors duration-200
               hover:bg-white/5 lg:p-12"
      >
        <div class="flex items-start justify-between">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-works-accent">
            E-mail
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            class="text-works-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-works-text"
            aria-hidden="true"
          >
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
        </div>

        <span class="text-2xl font-semibold tracking-tight text-works-text transition-colors duration-200
                     group-hover:text-white sm:text-3xl lg:text-4xl">
          lucas.oronha18@gmail.com
        </span>
      </a>

    </div>

  </div>
</section>